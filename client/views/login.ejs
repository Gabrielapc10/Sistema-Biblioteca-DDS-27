<!-- importacao do header -->
<%- include('partials/header') %>

    <main class="container my-2 flex-grow-1">
        <h1 class="text-center">Estou na pagina de login</h1>
        <div class="d-flex flex-column">
        <form action="/usuarios/login" method="post">

            <!-- caixinha de email -->
            <div class="form-group">
                <label for="email"> Email: </label>
                <input type="email" name="email" id="email" required>
            </div>

            <!-- caixinha da senha -->
                <div class="form-group">
                <label for="senha">Senha: </label>
                <input type="password" name="senha" id="email" required>
                </div>

                <!-- botao de envio -->
                 <button type="submit"class="btn-subtle theme-accent mt-3"> Entrar</button>
            </form>
        </div>
    </main>

<!-- importacao do footer -->
<%- include('partials/footer') %>
