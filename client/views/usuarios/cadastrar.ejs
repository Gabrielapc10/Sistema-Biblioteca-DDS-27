<!-- importacao do header -->
<%- include('../partials/header') %>

    <main class="container my-2 flex-grow-1">
        <h1 >Estou na pagina de cadastro de usuario</h1>

        <!-- criar o formulario de cadastro -->
         <div class="d-flex flex-column">
            <!-- action - fala a rota que o botao vai enviar as informacoes -->
            <form action="/usuarios/cadastrar" method="post">
            
            <!-- caixinha de nome -->
            <div class="form-group">
                <label for="nome"> Nome: </label>
                <input type="nome" name="nome" id="nome" required class="form-control">
            </div>

            <!-- caixinha de email -->
            <div class="form-group">
                <label for="email"> Email: </label>
                <input type="email" name="email" id="email" required class="form-control">
            </div>

            <!-- caixinha de senha -->
            <div class="form-group">
                <label for="senha"> Senha: </label>
                <input type="senha" name="senha" id="senha" required class="form-control">
            </div>

                <!-- caixinha de perfil -->
                <div class="form-group">
                    <label for="perfil"> Perfil: </label>
                    <select name="perfil" id="perfil" class="form-control">
                        <option value="adm">Administrador</option>
                        <option value="bibliotecaria">Bibliotecaria</option>
                    </select>
                </div>
                
                <!-- botao de envio -->
                 <button type="submit"class="btn-subtle theme-accent mt-3"> Cadastrar
                 </button>
            </form>
         </div>
    </main>

    
<!-- importacao do footer -->
<%- include('../partials/footer') %>